# 默认：自动检测文本文件，统一用 LF 存储
* text=auto eol=lf

# 明确指定常见文本类型用 LF
*.js    text eol=lf
*.ts    text eol=lf
*.jsx   text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows 批处理文件必须用 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不要转换
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary